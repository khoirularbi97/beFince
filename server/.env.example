DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
# Alamat frontend (pisahkan dengan koma kalau lebih dari satu). Kosong = semua asal diizinkan.
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
# WAJIB: kunci rahasia untuk menandatangani token login (minimal 32 karakter, jangan dibagikan).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Masa berlaku token login (default 7d)
JWT_EXPIRES=7d
# Setelah akunmu dibuat, isi false agar orang lain tidak bisa mendaftar
ALLOW_REGISTRATION=true
# Buat/upgrade tabel otomatis saat server menyala (aman diulang). Cocok untuk Render gratis yang tanpa shell.
AUTO_DB_INIT=false
# Zona waktu untuk menentukan "hari ini" dan jam transaksi (default Asia/Jakarta).
# WIB = Asia/Jakarta, WITA = Asia/Makassar, WIT = Asia/Jayapura
APP_TZ=Asia/Jakarta

# ---- Analisa AI (opsional, mati secara bawaan) ----
# Analisa berbasis aturan selalu tersedia tanpa ini. AI hanya aktif kalau AI_ENABLED=true DAN kunci API diisi,
# dan hanya untuk pengguna yang memberi izin di dalam aplikasi. Yang dikirim: ringkasan angka, tanpa catatan transaksi, nama, email, atau nomor rekening.
AI_ENABLED=false
# Penyedia: anthropic (bawaan) | groq | gemini | openrouter | openai | compat (server lain yang kompatibel OpenAI)
# Gratis tanpa kartu: groq (paling mudah) atau gemini. Lihat README bagian "Analisa AI gratis".
AI_PROVIDER=anthropic
# Kunci API penyedia di atas (ANTHROPIC_API_KEY lama tetap dikenali)
AI_API_KEY=
# Model: kosongkan untuk memakai bawaan penyedia (anthropic, groq, gemini). Wajib diisi untuk openrouter, openai, compat.
# Nama model sering berganti, jadi kalau muncul error model tidak ditemukan, cek daftar model di situs penyedia.
AI_MODEL=
# Hanya untuk compat (atau menimpa alamat bawaan), misalnya http://host:11434/v1
AI_BASE_URL=
# Batas analisa AI per pengguna per hari (hasil yang sama dipakai ulang tanpa dihitung)
AI_DAILY_LIMIT=5
